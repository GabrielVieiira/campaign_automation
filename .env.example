# Campaign Management Platform — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Campaign Management Platform
APP_VERSION=0.1.0
DEBUG=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development: SQLite
DATABASE_URL=sqlite:///./campaign_management.db

# Production: PostgreSQL (uncomment and fill)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/campaign_management

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-secure-random-string-at-least-64-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# RedTrack Integration
# ---------------------------------------------------------------------------
# The API key is used exclusively in the backend.
# It must NEVER be exposed in API responses, logs, or source code.
REDTRACK_API_KEY=your-redtrack-api-key-here
REDTRACK_BASE_URL=https://api.redtrack.io
